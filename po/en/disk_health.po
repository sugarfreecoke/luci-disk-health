msgid ""
msgstr ""
"Project-Id-Version: luci-app-disk-health\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"

msgid "磁盘健康"
msgstr "Disk Health"

msgid "设备总览"
msgstr "Device Overview"

msgid "设置"
msgstr "Settings"

msgid "磁盘健康 - 设置"
msgstr "Disk Health - Settings"

msgid "调整磁盘健康页面的采集行为与告警阈值。修改后返回“设备总览”并点击刷新即可生效。"
msgstr "Adjust the collection behavior and alert thresholds of the disk health page. After saving, return to the overview and click Refresh to apply."

msgid "采集设置"
msgstr "Collection"

msgid "数据缓存时间（秒）"
msgstr "Data cache TTL (seconds)"

msgid "两次真实采集之间的最小间隔，0 表示不缓存。建议 30~300，避免频繁唤醒硬盘。"
msgstr "Minimum interval between two real collections; 0 disables caching. 30~300 is recommended to avoid waking up sleeping disks."

msgid "跳过休眠中的硬盘"
msgstr "Skip disks in standby"

msgid "启用后使用 <code>smartctl -n standby</code>，不会为了读取 SMART 而唤醒已休眠的机械盘。"
msgstr "When enabled, uses <code>smartctl -n standby</code> so reading SMART will not wake up a sleeping HDD."

msgid "显示 USB 存储设备"
msgstr "Show USB storage"

msgid "关闭后列表中不再显示 U 盘 / USB 移动硬盘。"
msgstr "When disabled, USB drives / USB HDDs are hidden from the list."

msgid "告警阈值"
msgstr "Alert Thresholds"

msgid "温度警告阈值（°C）"
msgstr "Temperature warning (°C)"

msgid "温度危险阈值（°C）"
msgstr "Temperature critical (°C)"

msgid "剩余寿命警告阈值（%）"
msgstr "Remaining life warning (%)"

msgid "剩余寿命低于该值时标记为“警告”。"
msgstr "Marked as Warning when remaining life drops below this value."

msgid "剩余寿命危险阈值（%）"
msgstr "Remaining life critical (%)"

msgid "剩余寿命低于该值时标记为“危险”。"
msgstr "Marked as Danger when remaining life drops below this value."
