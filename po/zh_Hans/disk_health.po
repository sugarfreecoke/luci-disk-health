msgid ""
msgstr ""
"Project-Id-Version: luci-app-disk-health\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Language: zh_Hans\n"

msgid "磁盘健康"
msgstr "磁盘健康"

msgid "设备总览"
msgstr "设备总览"

msgid "设置"
msgstr "设置"

msgid "磁盘健康 - 设置"
msgstr "磁盘健康 - 设置"

msgid "调整磁盘健康页面的采集行为与告警阈值。修改后返回“设备总览”并点击刷新即可生效。"
msgstr "调整磁盘健康页面的采集行为与告警阈值。修改后返回“设备总览”并点击刷新即可生效。"

msgid "采集设置"
msgstr "采集设置"

msgid "数据缓存时间（秒）"
msgstr "数据缓存时间（秒）"

msgid "两次真实采集之间的最小间隔，0 表示不缓存。建议 30~300，避免频繁唤醒硬盘。"
msgstr "两次真实采集之间的最小间隔，0 表示不缓存。建议 30~300，避免频繁唤醒硬盘。"

msgid "跳过休眠中的硬盘"
msgstr "跳过休眠中的硬盘"

msgid "启用后使用 <code>smartctl -n standby</code>，不会为了读取 SMART 而唤醒已休眠的机械盘。"
msgstr "启用后使用 <code>smartctl -n standby</code>，不会为了读取 SMART 而唤醒已休眠的机械盘。"

msgid "显示 USB 存储设备"
msgstr "显示 USB 存储设备"

msgid "关闭后列表中不再显示 U 盘 / USB 移动硬盘。"
msgstr "关闭后列表中不再显示 U 盘 / USB 移动硬盘。"

msgid "告警阈值"
msgstr "告警阈值"

msgid "温度警告阈值（°C）"
msgstr "温度警告阈值（°C）"

msgid "温度危险阈值（°C）"
msgstr "温度危险阈值（°C）"

msgid "剩余寿命警告阈值（%）"
msgstr "剩余寿命警告阈值（%）"

msgid "剩余寿命低于该值时标记为“警告”。"
msgstr "剩余寿命低于该值时标记为“警告”。"

msgid "剩余寿命危险阈值（%）"
msgstr "剩余寿命危险阈值（%）"

msgid "剩余寿命低于该值时标记为“危险”。"
msgstr "剩余寿命低于该值时标记为“危险”。"

msgid "NAND 闪存类型（估算基准）"
msgstr "NAND 闪存类型（估算基准）"

msgid "raw NAND 没有标准寿命寄存器，本插件用“平均擦除计数 ÷ 额定擦写次数”估算剩余寿命。不同制程的额定擦写次数差异极大，请按路由器实际 NAND 类型选择：SLC≈100000，MLC≈10000，TLC≈3000，QLC≈1000。选“自定义”可手动填写。"
msgstr "raw NAND 没有标准寿命寄存器，本插件用“平均擦除计数 ÷ 额定擦写次数”估算剩余寿命。不同制程的额定擦写次数差异极大，请按路由器实际 NAND 类型选择：SLC≈100000，MLC≈10000，TLC≈3000，QLC≈1000。选“自定义”可手动填写。"

msgid "SLC（约 100000 次）"
msgstr "SLC（约 100000 次）"

msgid "MLC（约 10000 次）"
msgstr "MLC（约 10000 次）"

msgid "TLC（约 3000 次）"
msgstr "TLC（约 3000 次）"

msgid "QLC（约 1000 次）"
msgstr "QLC（约 1000 次）"

msgid "自定义（手动填写额定次数）"
msgstr "自定义（手动填写额定次数）"

msgid "NAND 额定擦写次数（自定义）"
msgstr "NAND 额定擦写次数（自定义）"

msgid "仅在上方选择“自定义”时生效。raw NAND 没有标准寿命寄存器，本插件用“平均擦除计数 ÷ 额定次数”估算剩余寿命，填错只会让估算值失真，不影响功能。"
msgstr "仅在上方选择“自定义”时生效。raw NAND 没有标准寿命寄存器，本插件用“平均擦除计数 ÷ 额定次数”估算剩余寿命，填错只会让估算值失真，不影响功能。"
